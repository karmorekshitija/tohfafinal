# =============================================================================
# Tohfa v2 — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git. Only .env.example is committed.
#
# IMPORTANT FOR PRODUCTION (RENDER):
# Since `.env` is git-ignored, modifying this local file will have zero effect
# on the live backend on Render. You MUST set these environment variables 
# (e.g. RAZORPAY_*, GEMINI_API_KEY) directly in the Render dashboard under 
# your backend service's Environment tab.
# 
# NOTE ON RAZORPAY: Test mode keys (rzp_test_...) will NEVER process real live 
# payments. Use LIVE keys and ensure your account is "Activated" for KYC.
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
FRONTEND_URL=https://thetohfa.in

# -----------------------------------------------------------------------------
# DATABASE — Neon PostgreSQL
# Get from: https://neon.tech → your project → Connection Details
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# -----------------------------------------------------------------------------
# JWT — Authentication
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=YOUR_JWT_ACCESS_SECRET_HERE
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET_HERE
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# CLOUDINARY — Image Storage
# Get from: https://cloudinary.com → Dashboard
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# -----------------------------------------------------------------------------
# RAZORPAY — Dual-Account Payments & Failover
# Get from: https://dashboard.razorpay.com → Settings → API Keys
# NOTE: Standard API Keys only allow inbound payment collections.
# They CANNOT withdraw or debit funds from your bank account.
# -----------------------------------------------------------------------------
# Primary Razorpay Account (Default)
RAZORPAY_PRIMARY_KEY_ID=YOUR_PRIMARY_RAZORPAY_KEY_ID
RAZORPAY_PRIMARY_KEY_SECRET=YOUR_PRIMARY_RAZORPAY_KEY_SECRET
RAZORPAY_PRIMARY_WEBHOOK_SECRET=YOUR_PRIMARY_RAZORPAY_WEBHOOK_SECRET

# Secondary Razorpay Account (Automatic Failover / Backup)
RAZORPAY_SECONDARY_KEY_ID=YOUR_SECONDARY_RAZORPAY_KEY_ID
RAZORPAY_SECONDARY_KEY_SECRET=YOUR_SECONDARY_RAZORPAY_KEY_SECRET
RAZORPAY_SECONDARY_WEBHOOK_SECRET=YOUR_SECONDARY_RAZORPAY_WEBHOOK_SECRET

# Legacy Single-Key Compatibility Fallback (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# GOOGLE GEMINI AI — Tanya AI Assistant
# Get from: https://aistudio.google.com → API Keys
# -----------------------------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# -----------------------------------------------------------------------------
# WHATSAPP — Meta WhatsApp Cloud API (Graph API)
# Get from: Meta for Developers → WhatsApp → API Setup
# -----------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_REDIRECT_ALL_TO=919755329298
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=            # permanent System User token, never logged
WHATSAPP_APP_SECRET=              # used to verify X-Hub-Signature-256
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_AUTOREPLY_ENABLED=false
WHATSAPP_TEMPLATE_NEW_ORDER=tohfa_new_order_v1
WHATSAPP_TEMPLATE_QUOTE=tohfa_quote_received_v1
WHATSAPP_TEMPLATE_PROOF=tohfa_proof_ready_v1
WHATSAPP_TEMPLATE_OCCASION=tohfa_occasion_reminder_v1
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_MAX_ATTEMPTS=4
SELLER_ORDER_EMAIL_FALLBACK_ENABLED=false
CRON_SECRET=                      # required for all /api/cron/* WhatsApp routes
OWNER_NOTIFY_EMAIL=               # your inbox for manual send tasks and admin alerts
WHATSAPP_MANUAL_MODE=true         # set to false to turn manual mode off
MANUAL_ESCALATION_MINUTES=60      # minutes before escalation reminder is sent
MANUAL_REMINDERS_REQUIRE_OPT_IN=true  # occasion reminders only for opted-in buyers

# -----------------------------------------------------------------------------
# TWILIO — WhatsApp Business API (Legacy)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX

# -----------------------------------------------------------------------------
# ITHINK LOGISTICS
# Get from: iThink Logistics partner account dashboard
# -----------------------------------------------------------------------------
ITHINK_API_KEY=YOUR_ITHINK_API_KEY
ITHINK_API_URL=https://api.ithinklogistics.com/api/v3
TOHFA_WAREHOUSE_NAME=Tohfa Central Warehouse
TOHFA_WAREHOUSE_PHONE=919876543210
TOHFA_WAREHOUSE_LINE1=Plot 101, Industrial Area
TOHFA_WAREHOUSE_LINE2=Phase 1
TOHFA_WAREHOUSE_CITY=Jaipur
TOHFA_WAREHOUSE_STATE=Rajasthan
TOHFA_WAREHOUSE_PINCODE=302001


# -----------------------------------------------------------------------------
# EMAIL — Resend API (Primary) & Nodemailer SMTP (Fallback)
# -----------------------------------------------------------------------------
# Resend (Recommended for Render Free tier & production)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Tohfa <onboarding@resend.dev> # Or your verified domain email

# SMTP (Optional fallback for localhost or servers with unblocked SMTP ports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true

# Notifications
ADMIN_EMAIL=admin@thetohfa.in

# -----------------------------------------------------------------------------
# ADMIN SEED
# Initial admin credentials — used only for first-run DB seed
# Change immediately after first login
# -----------------------------------------------------------------------------
ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN
