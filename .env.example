# =============================================================================
# Tohfa v2 — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git. Only .env.example is committed.
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# DATABASE — Neon PostgreSQL
# Get from: https://neon.tech → your project → Connection Details
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# -----------------------------------------------------------------------------
# JWT — Authentication
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=YOUR_JWT_ACCESS_SECRET_HERE
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET_HERE
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# CLOUDINARY — Image Storage
# Get from: https://cloudinary.com → Dashboard
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# -----------------------------------------------------------------------------
# RAZORPAY — Payments
# Get from: https://dashboard.razorpay.com → Settings → API Keys
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# -----------------------------------------------------------------------------
# GOOGLE GEMINI AI — Tanya AI Assistant
# Get from: https://aistudio.google.com → API Keys
# -----------------------------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# -----------------------------------------------------------------------------
# TWILIO — WhatsApp Business API
# Get from: https://console.twilio.com → Account Info
# WhatsApp Sender: Must be an approved Twilio WhatsApp sender number
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX

# -----------------------------------------------------------------------------
# ITHINK LOGISTICS
# Get from: iThink Logistics partner account dashboard
# -----------------------------------------------------------------------------
ITHINK_API_KEY=YOUR_ITHINK_API_KEY
ITHINK_API_URL=https://api.ithinklogistics.com/api/v3

# -----------------------------------------------------------------------------
# EMAIL — Nodemailer SMTP
# Use Gmail App Password, SendGrid, or any SMTP provider
# Gmail: https://myaccount.google.com → Security → App Passwords
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_EMAIL@gmail.com
SMTP_PASS=YOUR_APP_PASSWORD
EMAIL_FROM=Tohfa <noreply@thetohfa.in>

# -----------------------------------------------------------------------------
# ADMIN SEED
# Initial admin credentials — used only for first-run DB seed
# Change immediately after first login
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@thetohfa.in
ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN
