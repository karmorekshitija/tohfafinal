{
  "version": 2,
  "buildCommand": "npm --prefix backend install && npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/buyer/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/buyer/home.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/buyer/about",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/buyer/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/buyer/contact",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/buyer/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/buyer/bulk",
      "destination": "/bulk",
      "permanent": true
    },
    {
      "source": "/buyer/bulk.html",
      "destination": "/bulk",
      "permanent": true
    },
    {
      "source": "/buyer/faq",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/buyer/faq.html",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/buyer/categories",
      "destination": "/categories",
      "permanent": true
    },
    {
      "source": "/buyer/categories.html",
      "destination": "/categories",
      "permanent": true
    },
    {
      "source": "/customised-gifts",
      "destination": "/customized-gifts",
      "permanent": true
    },
    {
      "source": "/personalised-gifts",
      "destination": "/personalized-gifts",
      "permanent": true
    },
    {
      "source": "/gifts-online-india",
      "destination": "/gifts-in-india",
      "permanent": true
    },
    {
      "source": "/handmade-gifts-india",
      "destination": "/handmade-gifts",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://tohfafinal.onrender.com/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://tohfafinal.onrender.com/health"
    }
  ]
}