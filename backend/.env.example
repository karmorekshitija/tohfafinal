# ─── WhatsApp Cloud API ───────────────────────────────────────────────────────
# Meta WhatsApp Business Cloud API credentials and behaviour flags.
# See docs/WHATSAPP_SETUP.md for the full activation checklist.

# Master switch. Must equal the string 'true' to send anything via the API.
WHATSAPP_ENABLED=false

# Test redirect. ALL outbound messages go to this number while set.
# Default in code: 919755329298. Set to empty string to send to real recipients.
WHATSAPP_REDIRECT_ALL_TO=919755329298

# Meta Graph API version
WHATSAPP_GRAPH_VERSION=v26.0

# From Meta Business Manager - WhatsApp - Phone Numbers
WHATSAPP_PHONE_NUMBER_ID=

# Permanent System User token -- never log, never commit
WHATSAPP_ACCESS_TOKEN=

# App Secret from Meta App Dashboard -- used to verify X-Hub-Signature-256
WHATSAPP_APP_SECRET=

# Webhook verify token -- any random string; set the same in Meta webhook config
WHATSAPP_VERIFY_TOKEN=

# Send a one-time auto-reply to inbound messages within the 24-hr service window
WHATSAPP_AUTOREPLY_ENABLED=false

# Approved template names (must match exactly what is approved in Meta Business Manager)
WHATSAPP_TEMPLATE_NEW_ORDER=tohfa_new_order_v1
WHATSAPP_TEMPLATE_QUOTE=tohfa_quote_received_v1
WHATSAPP_TEMPLATE_PROOF=tohfa_proof_ready_v1
WHATSAPP_TEMPLATE_OCCASION=tohfa_occasion_reminder_v1

# BCP-47 language code for all templates
WHATSAPP_TEMPLATE_LANG=en

# Max retry attempts before marking a row as permanently failed
WHATSAPP_MAX_ATTEMPTS=4

# ─── Manual Mode ──────────────────────────────────────────────────────────────
# When WHATSAPP_ENABLED is not 'true', you receive one email per message with
# the exact copy-paste text and a one-tap wa.me link to send it yourself.

# Set to 'false' to suppress all manual tasks (rows still recorded in DB)
WHATSAPP_MANUAL_MODE=true

# Your inbox for manual send tasks and admin alerts
OWNER_NOTIFY_EMAIL=

# Minutes before an escalation reminder is sent for a still-pending task
MANUAL_ESCALATION_MINUTES=60

# Only send occasion reminder tasks for buyers who opted in to marketing
MANUAL_REMINDERS_REQUIRE_OPT_IN=true

# ─── Seller Email Fallback ────────────────────────────────────────────────────
# If a seller WhatsApp notification fails permanently, email the seller directly
SELLER_ORDER_EMAIL_FALLBACK_ENABLED=false

# ─── Cron Authentication ──────────────────────────────────────────────────────
# Required Bearer token for all /api/cron/* routes.
# Missing in production returns 503.
CRON_SECRET=

# ─── Email Transport (Resend API Primary + Nodemailer SMTP Fallback) ─────────
# Resend (Recommended for Render Free tier & production — Port 443 HTTPS API)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Tohfa <onboarding@resend.dev> # Or your verified domain email

# SMTP (Optional fallback for localhost or servers with unblocked SMTP ports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=

# Admin Notifications
ADMIN_EMAIL=admin@thetohfa.in

# ─── Tohfa Central Warehouse Logistics (Admin-Managed / Special Shops) ─────────
# Fallback pickup address for Tohfa Special & admin-managed shops that do not
# have their own verified artisan workshop address.
TOHFA_WAREHOUSE_NAME=Tohfa Central Warehouse
TOHFA_WAREHOUSE_PHONE=919876543210
TOHFA_WAREHOUSE_LINE1=Plot 101, Industrial Area
TOHFA_WAREHOUSE_LINE2=Phase 1
TOHFA_WAREHOUSE_CITY=Jaipur
TOHFA_WAREHOUSE_STATE=Rajasthan
TOHFA_WAREHOUSE_PINCODE=302001

